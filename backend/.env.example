# ==============================================================================
# Sushrusha Pharmacy Store Management System — Environment Configuration Example
# ==============================================================================
# Copy this file to backend/.env in your local environment.
# NEVER commit real credentials, secrets, or SMTP passwords to version control.

# Django Security Settings
SECRET_KEY=django-insecure-change-this-in-production-random-value-placeholder
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=sushrusha_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Frontend & CORS / CSRF Origins
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ==============================================================================
# Email Configuration
# ==============================================================================
# OPTION 1: Local Development (Console Backend - Default)
# No SMTP credentials required. Verification and reset links print to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sushrusha Pharmacy <no-reply@sushrusha.local>
SERVER_EMAIL=Sushrusha Pharmacy <no-reply@sushrusha.local>

# OPTION 2: Production / Real Email Delivery (Genuine SMTP Provider)
# When you acquire genuine SMTP credentials (e.g. Amazon SES, SendGrid, Mailgun, Brevo),
# switch EMAIL_BACKEND to smtp and uncomment/fill the parameters below:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-actual-smtp-api-key-here
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Sushrusha Pharmacy <verified-sender@yourdomain.com>
# SERVER_EMAIL=Sushrusha Pharmacy <alerts@yourdomain.com>

# Cookie Security Settings (Set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
